# Copia este archivo a .env y rellena los valores. NO subas .env al repo.
# API key gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_tu_api_key_aqui

# Modelo principal (gemini-3.5-flash = disponible, rápido y con tool-calling).
# Si se satura (503), cae automáticamente a los de respaldo de abajo.
QAWAY_GEMINI_MODEL=gemini-3.5-flash
QAWAY_GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-3.6-flash

# Límite de caché de escenas NISAR en disco (GB). Oracle Free da 200GB.
QAWAY_CACHE_MAX_GB=50
